# Public repository uses an explicit source allowlist.
/*
!/.gitignore
!/.dockerignore
!/.env.example
!/README.md
!/pyproject.toml
!/uv.lock
!/Dockerfile
!/docker-compose.yml
!/alembic.ini
!/src/
!/alembic/
!/tests/
!/docs/
!/scripts/
!/Evaluation/
!/WebApp/

# Private configuration, credentials, data, certificates and runtime artifacts.
**/.env
**/.env.*
!/.env.example
**/SecretConfig/
**/Private/
**/.local/
**/LocalCredentials*.json
**/*Credentials.json
**/*.key
**/*.pem
**/*.pfx
**/*.p12
**/*.dpapi
**/*.dump
**/*.sql.gz
**/*.pdf
**/*.zip
**/*.tar
**/*.tar.gz
**/*.mp4
**/*.webm
**/*.log
**/*.safetensors
**/*.bin
**/*.pt
**/*.pth
**/.venv/
**/node_modules/
**/*.egg-info/
**/.vite/
**/__pycache__/
**/*.py[cod]
**/.pytest_cache/
**/.ruff_cache/
**/.mypy_cache/
**/Build/
**/build/
**/dist/
**/coverage/
**/.coverage*
**/htmlcov/
**/test-results/
**/playwright-report/
**/.DS_Store
**/Thumbs.db

# Historical machine-bound acceptance launchers: retain locally, do not publish.
/src/finsight/workers/day18_api.py
/src/finsight/workers/prepare_day18.py

# Historical plans and learning notes stay on this computer, not in the public tree.
