APP_NAME=FinSight AI
APP_ENV=dev
APP_HOST=0.0.0.0
APP_PORT=9300
DATABASE_URL=postgresql+psycopg://finsight:finsight@localhost:55432/finsight
REDIS_URL=redis://127.0.0.1:56479/0
OBJECT_STORAGE_ROOT=.local/object-storage
MINERU_API_URL=http://127.0.0.1:59390

# LLM gateway: openai / deepseek / local
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-chat
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1

# Embedding gateway: local / api
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-m3
MILVUS_URI=http://localhost:59530
MILVUS_COLLECTION=finsight_document_chunks_v1
EMBEDDING_DIMENSION=1024

# Optional financial data provider
TUSHARE_TOKEN=

# Set a separate random secret (at least 32 bytes) to enable identity login.
AUTH_JWT_SECRET=
AUTH_TOKEN_MINUTES=30
